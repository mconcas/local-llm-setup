# ── llama.cpp server settings ────────────────────────────────────
# Path to the GGUF model file *inside* the container.
# The ./models/ directory on the host is mounted to /models in the container.
# Place your .gguf file in ./models/ and set the filename here.
MODEL_FILE=/models/model.gguf

# Context length (tokens). Adjust based on model and available VRAM.
CTX_SIZE=4096

# Number of layers to offload to GPU (-1 = all layers).
GPU_LAYERS=-1

# Number of parallel request slots (concurrent users).
PARALLEL=4

# Host port for the HTTPS endpoint.
HTTPS_PORT=8443

# (Optional) Host port to expose llama.cpp directly without TLS (debugging only).
# Leave empty to disable.
# DEBUG_PORT=8080
