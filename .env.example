# ── llama.cpp server settings ────────────────────────────────────
# Path to the GGUF model file *inside* the container.
# The ./models/ directory on the host is mounted to /models in the container.
# Place your .gguf file in ./models/ and set the filename here.
MODEL_FILE=/models/model.gguf

# Context length (tokens). Adjust based on model and available VRAM.
CTX_SIZE=4096

# Number of layers to offload to GPU (-1 = all layers).
GPU_LAYERS=-1

# Number of parallel request slots (concurrent users).
PARALLEL=4

# Host port for the HTTPS endpoint.
HTTPS_PORT=8443

# KV-cache quantisation (f16, q8_0, ...). Setting both to q8_0 is what makes a
# large CTX_SIZE fit alongside Q4_K_M weights on a 32 GB GPU.
CACHE_TYPE_K=f16
CACHE_TYPE_V=f16

# llama.cpp server image.
#LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda

# Host directory bind-mounted read-only at /models inside the container.
#MODELS_DIR=./models

# On Jetson Orin, activate the override (see README):
#COMPOSE_FILE=docker-compose.yml:docker-compose.jetson.yml

# The raw llama.cpp HTTP port is always published on 127.0.0.1:8080 (no TLS,
# localhost only) for debugging; it is not configurable via .env.
