# ── Platform ─────────────────────────────────────────────────────
# Run ./scripts/setup.sh to have these filled in for the detected hardware,
# or ./scripts/detect-platform.sh to see what it would choose.

# Compose files to combine. Jetson/Tegra hosts must include the overlay, which
# swaps GPU passthrough from the legacy `--gpus` path to CDI (the legacy path
# hangs on JetPack 6).
#   x86_64 discrete GPU: docker-compose.yml
#   Jetson (Tegra):      docker-compose.yml:docker-compose.jetson.yml
COMPOSE_FILE=docker-compose.yml

# Container image for the llama.cpp server. The upstream tag is multi-arch and
# covers both x86_64 and Jetson arm64.
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda

# Host directory holding the .gguf files, bind-mounted read-only at /models.
# Point this at a data disk if you keep models outside the repo.
#
# This is a bind *source*: `./models`, `/data/models`, `~/models` and
# `${HOME}/models` all work, but a bare relative path ("models") is the name of
# a volume to compose, not a directory, and the project will not start.
# Single quotes are literal to compose - '${HOME}/models' is not expanded, and
# becomes that same unusable volume name. Use double quotes or none.
MODELS_DIR=./models

# ── llama.cpp server settings ────────────────────────────────────
# Path to the GGUF model file *inside* the container.
# The MODELS_DIR directory on the host is mounted to /models in the container.
MODEL_FILE=/models/model.gguf

# Context length (tokens). Adjust based on model and available VRAM.
# On Jetson this competes with the OS for the same physical RAM.
CTX_SIZE=4096

# Number of layers to offload to GPU (-1 = all).
GPU_LAYERS=-1

# Number of parallel request slots (concurrent users). Each slot carves its own
# share out of the context window, so on memory-tight boards keep this at 1.
PARALLEL=4

# KV cache quantisation. q8_0 roughly halves KV memory against f16 for a
# negligible quality cost - the default choice on Jetson-class memory budgets.
CACHE_TYPE_K=f16
CACHE_TYPE_V=f16

# Host port for the HTTPS endpoint.
HTTPS_PORT=8443

# The raw llama.cpp port is always published on 127.0.0.1:8080 (loopback only,
# never the network) - docker-compose.yml binds it unconditionally, and both
# validate.sh and benchmark.sh talk to it there. It is not configurable from
# here; edit the `ports:` entry in docker-compose.yml if you need another port,
# and pass the new one to those two scripts with --base.
