# ── llama.cpp server settings ────────────────────────────────────
# Path to the GGUF model file *inside* the container.
# The ./models/ directory on the host is mounted to /models in the container.
# Defaults below size the reference model (Qwen3.8 27B Q6_K, see README) for a
# 32 GB discrete GPU; Jetson-class devices need a smaller model and context
# (see the README's Jetson section).
MODEL_FILE=/models/Qwen3.8-27B-Q6_K.gguf

# Context length (tokens). 131072 is the largest power-of-two window that fits
# next to the reference model's Q6_K weights with a q8_0 KV cache on a 32 GB
# GPU (native max: 262144).
CTX_SIZE=131072

# Number of layers to offload to GPU (-1 = all layers).
GPU_LAYERS=-1

# Number of parallel request slots. llama.cpp divides CTX_SIZE across slots,
# so keep 1 for a single-user deployment to get the full window per request.
PARALLEL=1

# Host port for the HTTPS endpoint.
HTTPS_PORT=8443

# Jinja chat template file inside the container (./templates is mounted at
# /templates). Must match the served model: when swapping MODEL_FILE, provide
# a matching template. The default is the Qwen3.8 GGUF-embedded template
# relaxed to accept system messages at any position and non-alternating
# roles, which strict templates reject with a 500 for clients like
# Claude Code. Leaving it empty is an error; it must point at a real file.
CHAT_TEMPLATE_FILE=/templates/qwen3.8-27b-relaxed.jinja

# Thinking: auto follows the chat template, off disables it (wanted for
# latency-bound roles such as the Claude Code small model; --reasoning-budget 0
# has no effect on Qwen models), on forces it.
REASONING=auto

# JSON object of extra chat-template variables.
CHAT_TEMPLATE_KWARGS={}

# KV-cache quantisation (f16, q8_0, ...). q8_0 halves KV memory versus f16;
# it is what makes CTX_SIZE=131072 fit alongside the Q6_K weights on a 32 GB
# GPU.
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0

# llama.cpp server image.
#LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda

# Host directory bind-mounted read-only at /models inside the container.
#MODELS_DIR=./models

# On Jetson Orin, activate the override (see README):
#COMPOSE_FILE=docker-compose.yml:docker-compose.jetson.yml

# ── Model routing (see README, "Small-model endpoint for Claude Code") ──
# Sidecar: models listed in SIDECAR_MODEL_NAMES (comma-separated) are
# forwarded to another instance of this stack at
# SIDECAR_UPSTREAM (e.g. a Jetson running the small-model profile). nginx
# authenticates there with the client certificate found in SIDECAR_CERTS_DIR
# (ca.crt, client.crt, client.key issued by that instance's CA; keep the
# directory outside this repository). Every other model name is served by the
# local llama.cpp; requests never leave the deployment. Empty
# SIDECAR_UPSTREAM disables the leg.
# nginx resolves SIDECAR_UPSTREAM through Docker DNS, which does not apply
# the host's search domains: use a resolvable FQDN. When the sidecar's server
# certificate carries a different (e.g. bare) hostname in its SANs, set
# SIDECAR_TLS_NAME to that name; it defaults to the SIDECAR_UPSTREAM host.
SIDECAR_MODEL_NAMES=
SIDECAR_UPSTREAM=
#SIDECAR_TLS_NAME=
#SIDECAR_CERTS_DIR=/home/me/.config/local-llm/jetson

# Jetson Orin Nano 8 GB profile as the Claude Code small-model endpoint:
#MODEL_FILE=/models/Qwen3.5-4B-UD-Q4_K_XL.gguf
#CHAT_TEMPLATE_FILE=/templates/qwen3.5-4b-relaxed.jinja
#CTX_SIZE=65536
#REASONING=off

# ── Observability add-on (see README) ───────────────────────────
# Activate with (append :docker-compose.jetson.yml as well on Jetson):
#COMPOSE_FILE=docker-compose.yml:docker-compose.observability.yml

# Grafana login. The password is mandatory when the add-on is active.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Public URL of Grafana as reached through nginx; must end in /grafana/.
GRAFANA_ROOT_URL=https://localhost:8443/grafana/

# Retention of metrics (Prometheus duration) and logs (Loki duration, hours).
METRICS_RETENTION=30d
LOGS_RETENTION=720h

# The raw llama.cpp HTTP port is always published on 127.0.0.1:8080 (no TLS,
# localhost only) for debugging; it is not configurable via .env.
