          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "sent"
        },
        {
          "refId": "B",
          "expr": "sum(rate({container=\"llama-proxy\"} |= \"\\\"status\\\":\" | json | client_cn=~\"$client_cn\" | uri=~\"$uri\" | unwrap request_length [$__auto]))",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "received"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "Bps",
          "custom": {
            "lineWidth": 1,
