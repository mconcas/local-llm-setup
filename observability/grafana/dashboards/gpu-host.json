{
  "uid": "gpu-host",
  "title": "GPU, host and containers",
  "tags": [
    "local-llm",
    "gpu",
    "host"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Compose project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(container_last_seen{container_label_com_docker_compose_project=~\".+\"}, container_label_com_docker_compose_project)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "sort": 1,
        "current": {
          "text": "local-llm-setup",
          "value": "local-llm-setup"
        }
      }
    ]
  },
