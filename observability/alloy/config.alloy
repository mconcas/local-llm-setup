discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"

  filter {
    name   = "label"
    values = ["com.docker.compose.project=" + sys.env("COMPOSE_PROJECT")]
  }
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  labels     = {job = "docker"}
  forward_to = [loki.process.pipeline.receiver]
}

loki.process "pipeline" {
  stage.match {
    selector = "{container=\"llama-proxy\"} |= \"\\\"status\\\":\""

    stage.json {
      expressions = {
        ts     = "time",
        status = "status",
        method = "method",
      }
    }

    stage.timestamp {
      source = "ts"
      format = "RFC3339"
    }

    stage.labels {
      values = {
        status = "",
        method = "",
      }
    }

    stage.template {
      source   = "level"
      template = "{{ if ge (int .status) 500 }}error{{ else if ge (int .status) 400 }}warn{{ else }}info{{ end }}"
    }

    stage.structured_metadata {
      values = {
        level = "",
      }
    }
  }

  stage.match {
    selector = "{container=\"llama-proxy\"} != \"\\\"status\\\":\""

    stage.regex {
      expression = "^\\S+ \\S+ \\[(?P<level>\\w+)\\] "
    }

    stage.structured_metadata {
      values = {
        level = "",
      }
    }
  }

  stage.match {
    selector = "{container=\"llama-server\"}"

    stage.regex {
      expression = "^\\S+ (?P<lvl>[IWED]) "
    }

    stage.template {
      source   = "level"
      template = "{{ if eq .lvl \"E\" }}error{{ else if eq .lvl \"W\" }}warn{{ else if eq .lvl \"D\" }}debug{{ else if eq .lvl \"I\" }}info{{ end }}"
    }

    stage.structured_metadata {
      values = {
        level = "",
      }
    }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

otelcol.receiver.otlp "claude_code" {
  http {
    endpoint         = "0.0.0.0:4318"
    include_metadata = true
  }

  output {
    metrics = [otelcol.processor.attributes.host.input]
    logs    = [otelcol.processor.attributes.host.input]
    traces  = [otelcol.processor.attributes.host.input]
  }
}

otelcol.processor.attributes "host" {
  action {
    key          = "host.name"
    from_context = "metadata.x-host-name"
    action       = "upsert"
  }

  output {
    metrics = [otelcol.processor.groupbyattrs.host.input]
    logs    = [otelcol.processor.groupbyattrs.host.input]
    traces  = [otelcol.processor.groupbyattrs.host.input]
  }
}

otelcol.processor.groupbyattrs "host" {
  keys = ["host.name"]

  output {
    metrics = [otelcol.processor.batch.otlp.input]
    logs    = [otelcol.processor.attributes.log_dedupe.input]
    traces  = [otelcol.processor.batch.otlp.input]
  }
}

otelcol.processor.attributes "log_dedupe" {
  action {
    key    = "gen_ai.provider.name"
    action = "delete"
  }

  output {
    logs = [otelcol.processor.batch.otlp.input]
  }
}

otelcol.processor.batch "otlp" {
  output {
    metrics = [otelcol.exporter.otlphttp.prometheus.input]
    logs    = [otelcol.exporter.otlphttp.loki.input]
    traces  = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlphttp "prometheus" {
  client {
    endpoint = "http://prometheus:9090/api/v1/otlp"
  }
}

otelcol.exporter.otlphttp "loki" {
  client {
    endpoint = "http://loki:3100/otlp"
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    tls {
      insecure = true
    }
  }
}
